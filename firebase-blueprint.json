{
  "entities": {
    "crop": {
      "title": "Crop",
      "description": "Information about registered organic crops and vegetables",
      "type": "object",
      "properties": {
        "nome": {
          "type": "string",
          "description": "Popular name of the crop"
        },
        "cientifico": {
          "type": "string",
          "description": "Scientific name of the crop"
        },
        "dias": {
          "type": "number",
          "description": "Days to first harvest"
        },
        "duracao": {
          "type": "number",
          "description": "Harvest duration in days"
        }
      },
      "required": ["nome", "dias", "duracao"]
    },
    "purchase": {
      "title": "Purchase",
      "description": "Record of seedling or seed purchases and active stock",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique purchase item lot identifier"
        },
        "data": {
          "type": "string",
          "description": "Purchase date (YYYY-MM-DD)"
        },
        "fornecedor": {
          "type": "string",
          "description": "Supplier name"
        },
        "nf": {
          "type": "string",
          "description": "Invoice number"
        },
        "tipo": {
          "type": "string",
          "description": "Type: Muda (seedling) or Semente (seed)"
        },
        "cultura": {
          "type": "string",
          "description": "Associated crop name"
        },
        "quantidade": {
          "type": "number",
          "description": "Purchased quantity or grams"
        },
        "saldo": {
          "type": "number",
          "description": "Current available stock balance"
        },
        "status": {
          "type": "string",
          "description": "Stock item status (e.g. Ativo, Esgotado)"
        }
      },
      "required": ["id", "data", "fornecedor", "tipo", "cultura", "quantidade", "saldo", "status"]
    },
    "planting": {
      "title": "Planting",
      "description": "Record of a planting in the field",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique planting identifier"
        },
        "idLote": {
          "type": "string",
          "description": "Source purchase lot ID"
        },
        "data": {
          "type": "string",
          "description": "Date of planting (YYYY-MM-DD)"
        },
        "cultura": {
          "type": "string",
          "description": "Associated crop name"
        },
        "tipo": {
          "type": "string",
          "description": "Type: Muda, Semente, or Perene"
        },
        "talhao": {
          "type": "string",
          "description": "Plot or bed identifier"
        },
        "quantidade": {
          "type": "number",
          "description": "Planted quantity (units or area)"
        },
        "previsao": {
          "type": "string",
          "description": "Estimated first harvest date"
        },
        "status": {
          "type": "string",
          "description": "Field status: No campo, Esperando colheita, Colhendo, Finalizado"
        },
        "totalColhido": {
          "type": "number",
          "description": "Aggregated harvest total"
        },
        "unidade": {
          "type": "string",
          "description": "Quantity unit (e.g. Unidades, m²)"
        },
        "aduboQt": {
          "type": "number",
          "description": "Fertilizer cartloads quantity"
        },
        "aduboComp": {
          "type": "string",
          "description": "Fertilizer composition detail"
        },
        "dataFim": {
          "type": "string",
          "description": "Finalization date (YYYY-MM-DD)"
        },
        "perdas": {
          "type": "number",
          "description": "Final planting losses"
        },
        "obs": {
          "type": "string",
          "description": "Final comments or observations"
        }
      },
      "required": ["id", "data", "cultura", "tipo", "talhao", "quantidade", "status"]
    },
    "harvest": {
      "title": "Harvest",
      "description": "Daily harvest logging records",
      "type": "object",
      "properties": {
        "idSessao": {
          "type": "string",
          "description": "Harvest session grouping identifier"
        },
        "idPlantio": {
          "type": "string",
          "description": "Source planting identifier"
        },
        "data": {
          "type": "string",
          "description": "Harvest date (YYYY-MM-DD)"
        },
        "cultura": {
          "type": "string",
          "description": "Harvested crop name"
        },
        "talhao": {
          "type": "string",
          "description": "Source plot identifier"
        },
        "qtd": {
          "type": "number",
          "description": "Harvested quantity"
        }
      },
      "required": ["idSessao", "idPlantio", "data", "cultura", "talhao", "qtd"]
    },
    "metadata": {
      "title": "Metadata",
      "description": "General system configuration and settings like organic certification details",
      "type": "object",
      "properties": {
        "seloValidade": {
          "type": "string",
          "description": "Valid until date of certification"
        },
        "seloVisita": {
          "type": "string",
          "description": "Last audit visit date"
        }
      }
    },
    "authorized_email": {
      "title": "Authorized Email",
      "description": "Allowed user email for application access",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Allowed user email address"
        },
        "addedBy": {
          "type": "string",
          "description": "Email or ID of user who authorized this email"
        },
        "addedAt": {
          "type": "string",
          "description": "Timestamp when authorization was granted"
        }
      },
      "required": ["email"]
    },
    "license": {
      "title": "License & Compliance Record",
      "description": "Certifications, environmental licenses, water permits, organic stamps and renewal dates",
      "type": "object",
      "properties": {
        "titulo": {
          "type": "string",
          "description": "Name or title of certificate or license"
        },
        "orgaoEmissor": {
          "type": "string",
          "description": "Issuing agency or certification body"
        },
        "numeroRegistro": {
          "type": "string",
          "description": "Registration, permit, or certificate number"
        },
        "tipo": {
          "type": "string",
          "description": "License type: Selo Orgânico, Outorga de Água, Licença Ambiental, Alvará, Laudo Técnico, CAR, Outro"
        },
        "dataEmissao": {
          "type": "string",
          "description": "Issue or last audit date (YYYY-MM-DD)"
        },
        "dataValidade": {
          "type": "string",
          "description": "Expiration or next renewal date (YYYY-MM-DD)"
        },
        "responsavel": {
          "type": "string",
          "description": "Responsible person or technician"
        },
        "observacoes": {
          "type": "string",
          "description": "Additional notes or process tracking numbers"
        },
        "ativo": {
          "type": "boolean",
          "description": "Whether license is currently active"
        }
      },
      "required": ["titulo", "orgaoEmissor", "tipo", "dataValidade"]
    }
  },
  "firestore": {
    "/crops/{cropId}": {
      "schema": "crop",
      "description": "Collection of registered crop definitions"
    },
    "/purchases/{purchaseId}": {
      "schema": "purchase",
      "description": "Collection of purchase and stock inventory batches"
    },
    "/plantings/{plantingId}": {
      "schema": "planting",
      "description": "Collection of plantings in the field"
    },
    "/harvests/{harvestId}": {
      "schema": "harvest",
      "description": "Collection of individual harvest logs"
    },
    "/metadata/{metaId}": {
      "schema": "metadata",
      "description": "Collection of global system configurations and certificate dates"
    },
    "/licenses/{licenseId}": {
      "schema": "license",
      "description": "Collection of certificates, water rights permits, environmental licenses and renewal dates"
    },
    "/authorized_emails/{emailId}": {
      "schema": "authorized_email",
      "description": "Collection of allowed user emails for login authorization"
    }
  }
}
